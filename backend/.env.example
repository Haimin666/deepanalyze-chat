# ============================================
# DeepAnalyze Backend Configuration
# ============================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=deepanalyze

# JWT Configuration
JWT_SECRET_KEY=your_very_secure_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8200

# File Server Configuration
HTTP_SERVER_PORT=8100
HTTP_SERVER_BASE=http://localhost:8100

# Workspace Configuration
WORKSPACE_BASE_DIR=workspace

# AI/LLM Configuration
API_BASE=http://localhost:8000/v1
MODEL_PATH=DeepAnalyze-8B
USE_MOCK_LLM=true

# Code Execution Configuration
CODE_EXECUTION_TIMEOUT=120

# Session Configuration (minutes)
SESSION_TIMEOUT_MINUTES=10

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
