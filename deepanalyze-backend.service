[Unit]
Description=DeepAnalyze Backend API Service
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/deepanalyze/backend
Environment="PATH=/opt/deepanalyze/venv/bin"
EnvironmentFile=/opt/deepanalyze/backend/.env
ExecStart=/opt/deepanalyze/venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=append:/opt/deepanalyze/logs/backend.log
StandardError=append:/opt/deepanalyze/logs/backend.log

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
