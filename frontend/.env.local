# Three Panel Interface - 前端环境配置
# 复制此文件为 .env.local 并根据实际情况修改

# =====================
# API 服务配置
# =====================
# 后端 API 服务地址
NEXT_PUBLIC_BACKEND_URL=http://localhost:8200

# 文件服务器地址
NEXT_PUBLIC_FILE_SERVER_URL=http://localhost:8100

# Mock LLM 服务地址（用于开发测试）
NEXT_PUBLIC_MOCK_LLM_URL=http://localhost:8000

# =====================
# 数据库配置（可选）
# =====================
# 如果需要连接数据库，配置以下选项
# 数据库连接 URL（MySQL）
# DATABASE_URL=mysql://user:password@localhost:3306/three_panel

# 数据库连接 URL（SQLite）
# DATABASE_URL=file:./dev.db
